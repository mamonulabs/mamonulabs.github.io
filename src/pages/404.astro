---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const exits = [
  { label: 'Home', href: '/' },
  { label: 'All Plugins', href: '/plugins' },
  { label: 'InfoBits', href: '/infobits' },
];
---
<BaseLayout
  title="404 — Lost in Space"
  description="This page could not be found."
  noindex
>
  <Header />
  <main class="flex-grow">
    <section class="px-6 md:px-12 py-24 md:py-40 grid-border-b">
      <div class="max-w-[1400px] mx-auto">
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-8 block">Error 404</span>
        <h1 class="text-7xl md:text-9xl font-bold leading-[0.85] tracking-tighter uppercase mb-12">
          lost <br /> in space
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
          <div class="lg:col-span-7">
            <p class="text-xl md:text-2xl text-slate-300 font-light leading-relaxed mb-6">
              Somewhere between the send and the return, this page got dropped.
            </p>
            <p class="text-lg text-slate-500 font-light leading-relaxed max-w-lg">
              Probability said no. Roll a different seed, or drift back toward
              something that still exists.
            </p>
          </div>

          <div class="lg:col-span-5">
            <span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-6 block">Exits</span>
            <div class="flex flex-col gap-3">
              {exits.map((exit, i) => (
                <a
                  href={exit.href}
                  class="group flex items-center justify-between border border-white/10 px-6 py-4 font-bold uppercase tracking-widest hover:border-primary hover:text-primary transition-all"
                >
                  <span class="flex items-center gap-4">
                    <span class="text-xs text-slate-600 group-hover:text-primary transition-colors">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {exit.label}
                  </span>
                  <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 md:px-12 py-10">
      <p class="max-w-[1400px] mx-auto text-[10px] text-slate-600 uppercase tracking-[0.2em]">
        Seed 0.123456 · Mode Per Page · Step 404 / 404 · Drop 100%
      </p>
    </section>
  </main>
  <Footer />
</BaseLayout>
